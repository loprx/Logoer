<!--
  Fork note (loprx/Logoer): this feed serves builds published from this fork only.
  Upstream's items (0.1.0–0.2.2) were removed because their enclosures are signed
  with upstream's EdDSA key, while Logoer/Info.plist now carries this fork's public
  key — Sparkle would reject them anyway. Builds released before 0.3.0 still read
  upstream's feed (their Info.plist points there) and are unaffected.

  To publish a new release:
    1. bump MARKETING_VERSION / CURRENT_PROJECT_VERSION in Logoer.xcodeproj
    2. ./scripts/build.sh
    3. ditto -c -k -sequesterRsrc -keepParent build/Logoer.app
         build-release/Logoer-v<version>-macos-arm64.zip
       (use the double-dash forms of those ditto flags)
    4. .build/artifacts/sparkle/Sparkle/bin/sign_update <zip>   -> edSignature + length
    5. add an <item> above with the GitHub Release download URL
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>Logoer</title>
        <language>en</language>
        <item>
            <title>v0.3.1</title>
            <pubDate>Sat, 25 Oct 2026 08:05:00 +0800</pubDate>
            <sparkle:version>031</sparkle:version>
            <sparkle:shortVersionString>0.3.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>11.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                  <style>ul{margin-top: 0;margin-bottom: 7;padding-left: 18;}</style><ul>
                  <li>修复全屏时唤出菜单栏后系统苹果图标与自定义图标重叠的问题</li>
                  <li>自动遮蔽在全屏菜单栏隐藏时不再误采样应用内容</li>
                  <li>菜单栏唤出时遮罩出现更快</li>
                  </ul><ul>
                  <li>Fixed the system Apple logo overlapping the custom logo when the menu bar is revealed in full screen</li>
                  <li>Auto-Mask no longer samples the app's own content while the full-screen menu bar is hidden</li>
                  <li>The mask now appears faster when the menu bar is revealed</li>
                  </ul>
            ]]></description>
            <enclosure url="https://github.com/loprx/Logoer/releases/download/0.3.1/Logoer-v0.3.1-macos-arm64.zip" length="1723778" type="application/octet-stream" sparkle:edSignature="hSsHYQYXtJ+nTUZehCCFKyH5KuGFVIBGOBE8YSdi3XCgMkpRXdUpBoS4u30nWENv4/5srTHHuivrHoREPlyXBQ=="/>
        </item>
        <item>
            <title>v0.3.0</title>
            <pubDate>Sat, 24 Oct 2026 20:30:00 +0800</pubDate>
            <sparkle:version>030</sparkle:version>
            <sparkle:shortVersionString>0.3.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>11.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                  <style>ul{margin-top: 0;margin-bottom: 7;padding-left: 18;}</style><ul>
                  <li>修复 macOS 26 上无法打开设置面板的问题</li>
                  <li>新增 "电量指示器 (Linux)" 和 "电量指示器 (Windows)" 图标样式</li>
                  <li>为 macOS 26 重新实现全屏空间检测, 全屏自动隐藏更加准确</li>
                  <li>自动遮蔽不再反复弹出屏幕录制权限请求</li>
                  <li>支持仅用 Xcode Command Line Tools 构建</li>
                  </ul><ul>
                  <li>Fixed the settings panel not opening on macOS 26</li>
                  <li>Added "Battery: Linux" and "Battery: Windows" logo styles</li>
                  <li>Reimplemented full-screen Space detection for macOS 26</li>
                  <li>Auto-Mask no longer re-prompts for Screen Recording permission</li>
                  <li>Can be built with the Command Line Tools alone</li>
                  </ul>
            ]]></description>
            <enclosure url="https://github.com/loprx/Logoer/releases/download/0.3.0/Logoer-v0.3.0-macos-arm64.zip" length="1717992" type="application/octet-stream" sparkle:edSignature="rpGJbPF4HKuP+rB8TiKLNuBqg0zB7LRzlPq3ODVKHybCaKrbIZ7eY2LxBQ4RPaKCk+78CdY43C97hlcCH8aeDw=="/>
        </item>
    </channel>
</rss>
